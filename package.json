{
  "name": "didit-demo-center",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx -c .eslintrc.json --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.mjs\"",
    "test:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 \"tests/e2e/*.e2e.mjs\"",
    "test:e2e:crypto-exchange": "playwright test e2e/crypto-exchange.spec.ts",
    "test:e2e:aurora-play": "playwright test e2e/aurora-play.spec.ts",
    "test:e2e:demo-center": "playwright test e2e/demo-center-chrome.spec.ts",
    "test:e2e:northmarket": "playwright test e2e/northmarket.spec.ts",
    "test:e2e:product-demos": "playwright test e2e/product-demos.spec.ts",
    "igaming:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/igaming-setup.mjs",
    "fintech:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fintech-setup.mjs",
    "sync:design-system": "node scripts/sync-design-system.mjs",
    "sync:website-chrome": "node scripts/sync-website-chrome.mjs",
    "check:website-chrome": "node scripts/check-website-chrome-parity.mjs",
    "check:docs-links": "node scripts/check-docs-links.mjs",
    "shots": "node scripts/capture-screenshots.mjs",
    "marketplace:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/marketplace-setup.mjs",
    "crypto-exchange:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crypto-exchange-setup.mjs"
  },
  "dependencies": {
    "@didit-protocol/auth": "file:vendor/didit-sdk/didit-protocol-auth-0.1.0.tgz",
    "@didit-protocol/auth-nextjs": "file:vendor/didit-sdk/didit-protocol-auth-nextjs-0.1.0.tgz",
    "@didit-protocol/auth-react": "file:vendor/didit-sdk/didit-protocol-auth-react-0.1.0.tgz",
    "@didit-protocol/sdk-web": "file:vendor/didit-sdk/didit-protocol-sdk-web-0.5.0.tgz",
    "@didit-protocol/signals": "file:vendor/didit-sdk/didit-protocol-signals-0.1.0.tgz",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "~11.18.2",
    "intl-messageformat": "^10.5.0",
    "lucide-react": "^0.469.0",
    "next": "15.5.28",
    "next-intl": "^4.0.0",
    "prettier": "^3.3.3",
    "qrcode.react": "^4.2.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "20.5.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@typescript-eslint/parser": "7.2.0",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^8.2.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.23.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "playwright": "1.60.0",
    "postcss": "8.4.38",
    "tailwind-variants": "0.1.20",
    "tailwindcss": "3.4.3",
    "typescript": "5.5.4"
  },
  "overrides": {
    "@didit-protocol/auth": "$@didit-protocol/auth",
    "@didit-protocol/auth-react": "$@didit-protocol/auth-react",
    "@didit-protocol/signals": "$@didit-protocol/signals"
  },
  "pnpm": {
    "overrides": {
      "@didit-protocol/auth": "file:vendor/didit-sdk/didit-protocol-auth-0.1.0.tgz",
      "@didit-protocol/auth-react": "file:vendor/didit-sdk/didit-protocol-auth-react-0.1.0.tgz",
      "@didit-protocol/signals": "file:vendor/didit-sdk/didit-protocol-signals-0.1.0.tgz"
    }
  }
}
